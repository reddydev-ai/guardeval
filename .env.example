# Local configuration only. Copy to .env, set local test keys, NEVER commit .env.
# The default CI workflow supplies throwaway values and uses no LLM credentials.
#
# python -m app.live runs REAL SERVICE integration tests.
# python -m app.runner is the LEGACY synthetic-only scorer.
# Do not use real company documents or public service endpoints for these demos.

# GuardEval judge credentials; only needed for EVAL_REQUIRE_LLM=true
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o
EVAL_REQUIRE_LLM=false

# Protected, disposable PolicyMind + FlowAgent services
POLICYMIND_URL=http://127.0.0.1:8000
POLICYMIND_API_KEY=
POLICYMIND_EVAL_KEY=
FLOWAGENT_URL=http://127.0.0.1:8001
FLOWAGENT_API_KEY=
FLOWAGENT_REVIEWER_KEY=

# Remote evaluation is denied unless BOTH are explicitly configured.
# Only authorize private, approved HTTPS hosts.
ALLOW_REMOTE_EVAL=false
EVAL_ALLOWED_HOSTS=

# Optional redacted report path (no document text, model outputs or keys)
LIVE_EVAL_REPORT=live-evaluation-report.json

# Strict LLM-model quality thresholds (these do NOT confer production safety)
MIN_FAITHFULNESS=0.70
MIN_ANSWER_RELEVANCY=0.70
MIN_CONTEXT_PRECISION=0.60
MAX_HALLUCINATION=0.30
MIN_TASK_COMPLETION=0.70

# Optional LangSmith tracing (can transfer prompts/data to a separate service).
# Enable only for authorized synthetic evaluation data.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=guardeval

