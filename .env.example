# --- Required ---
OPENAI_API_KEY=sk-your-key-here
JUDGE_MODEL=gpt-4o

# --- Live services (optional) ---
# If set, GuardEval evaluates the real APIs. If empty, it runs OFFLINE on gold data.
POLICYMIND_URL=
FLOWAGENT_URL=

# --- Thresholds (quality gates) ---
MIN_FAITHFULNESS=0.70
MIN_ANSWER_RELEVANCY=0.70
MIN_CONTEXT_PRECISION=0.60
MAX_HALLUCINATION=0.30
MIN_TASK_COMPLETION=0.70

# --- Optional: LangSmith tracing ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-your-key-here
# LANGCHAIN_PROJECT=guardeval
